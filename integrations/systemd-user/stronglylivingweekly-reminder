#!/usr/bin/env python3
"""Notify while the previous week's Strongly Living Weekly review is due."""

from __future__ import annotations

import argparse
from datetime import datetime, timedelta
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--now",
        help="Override the local check time (ISO 8601); intended for tests.",
    )
    parser.add_argument(
        "--summary",
        type=Path,
        help="Override the desktop-summary path; intended for tests.",
    )
    parser.add_argument("--dry-run", action="store_true")
    return parser.parse_args()


def local_now(override: str | None) -> datetime:
    if not override:
        return datetime.now().astimezone()

    parsed = datetime.fromisoformat(override)
    return parsed.astimezone() if parsed.tzinfo else parsed


def default_summary_path() -> Path:
    state_home = os.environ.get("XDG_STATE_HOME")
    if state_home:
        return Path(state_home) / "stronglylivingweekly" / "summary-v1.json"
    return Path.home() / ".local" / "state" / "stronglylivingweekly" / "summary-v1.json"


def review_is_due(summary_path: Path, now: datetime) -> tuple[bool, str]:
    if now.weekday() != 0:
        return False, "not-monday"

    try:
        summary = json.loads(summary_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return False, "summary-unavailable"

    if summary.get("schema") != "stronglylivingweekly.summary.v1":
        return False, "summary-invalid"

    due_week = (now.date() - timedelta(days=7)).isoformat()
    if summary.get("lastOnTimeReviewWeekStart") == due_week:
        return False, "complete"
    return True, due_week


def send_notification() -> bool:
    title = "Weekly review is open"
    body = "Last week is still waiting. Open Strongly Living Weekly and seal it before midnight."

    dms = shutil.which("dms")
    if dms:
        result = subprocess.run(
            [
                dms,
                "notify",
                title,
                body,
                "--app",
                "Strongly Living Weekly",
                "--icon",
                "calendar_view_week",
                "--timeout",
                "12000",
            ],
            check=False,
        )
        if result.returncode == 0:
            return True

    notify_send = shutil.which("notify-send")
    if notify_send:
        return (
            subprocess.run(
                [
                    notify_send,
                    "--app-name=Strongly Living Weekly",
                    "--icon=calendar_view_week",
                    "--urgency=normal",
                    "--expire-time=12000",
                    title,
                    body,
                ],
                check=False,
            ).returncode
            == 0
        )
    return False


def main() -> int:
    arguments = parse_arguments()
    now = local_now(arguments.now)
    due, reason = review_is_due(arguments.summary or default_summary_path(), now)

    if arguments.dry_run:
        print(f"notify={str(due).lower()} reason={reason}")
        return 0
    if not due:
        return 0
    if not send_notification():
        print("stronglylivingweekly-reminder: notification delivery failed", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
